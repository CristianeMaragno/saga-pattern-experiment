{
  "title": "Saga — visão operacional",
  "uid": "saga-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Throughput HTTP por serviço (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (servico) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{servico}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Taxa de erro HTTP 5xx (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (servico) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "legendFormat": "{{servico}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latência p95 do POST /api/v1/solicitacoes (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v1/solicitacoes\"}[1m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap JVM utilizada (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (servico) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{servico}}"
        }
      ]
    }
  ]
}
