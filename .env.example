# Fatores experimentais da rodada. Copie para .env e ajuste, ou deixe o script
# scripts/run-experiments.sh gerar as combinações automaticamente.

# Identifica a rodada; nomeia o CSV exportado ao final.
EXPERIMENT_RUN_ID=local

# BACKWARD | FORWARD | HYBRID
RECOVERY_STRATEGY=BACKWARD

# NONE | TEMPORARY | PERMANENT
FAULT_SCENARIO=NONE

# T2 (inicial) | T4 (intermediária) | T6 (tardia) — ignorado se FAULT_SCENARIO=NONE
FAULT_POSITION=T4

# Tentativas adicionais depois da primeira, nos modos Forward e Híbrido.
RECOVERY_RETRY_LIMIT=3
RECOVERY_RETRY_BACKOFF_MS=200
RECOVERY_RETRY_BACKOFF_MAX_MS=5000

# Quantas execuções iniciais uma falha TEMPORARY derruba antes de se curar.
# Precisa ser menor que RECOVERY_RETRY_LIMIT para o Forward conseguir recuperar.
FAULT_TEMPORARY_FAILURES=2

# Tempo simulado da decisão de aprovação (substitui a espera real de dias).
APPROVAL_DECISION_DELAY_SECONDS=2
